{
  "name": "snapmark",
  "displayName": "SnapMark - Image Editor",
  "description": "Image editor for annotating screenshots in VS Code. Draw arrows and shapes, highlight, redact, crop, measure and add comments, then paste into Claude, Copilot, Cursor or any AI chat.",
  "version": "1.0.1",
  "publisher": "RajithaDisanayaka",
  "license": "MIT",
  "icon": "media/Logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "AI",
    "Other"
  ],
  "keywords": [
    "image editor",
    "image edit",
    "edit image",
    "annotate image",
    "image annotation",
    "annotate",
    "annotation",
    "screenshot",
    "screenshot annotation",
    "image",
    "png",
    "draw",
    "markup",
    "crop",
    "redact",
    "highlight",
    "arrow",
    "paint",
    "measure",
    "color picker",
    "clipboard",
    "paste",
    "ai",
    "llm",
    "claude",
    "copilot",
    "cursor",
    "chatgpt",
    "codex",
    "ui review"
  ],
  "galleryBanner": {
    "color": "#0a0a0f",
    "theme": "dark"
  },
  "qna": "marketplace",
  "bugs": {
    "url": "https://github.com/rajitha302/Snapmark/issues"
  },
  "homepage": "https://snapmarkapp.netlify.app",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "snapmark.annotate",
        "title": "Snapmark: Annotate Clipboard Image",
        "category": "Snapmark"
      }
    ],
    "keybindings": [
      {
        "command": "snapmark.annotate",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      }
    ],
    "configuration": {
      "title": "Snapmark",
      "properties": {
        "snapmark.clipboardDetection": {
          "type": "boolean",
          "default": true,
          "description": "Watch the clipboard and highlight the Snapmark status-bar item when a new screenshot is detected."
        },
        "snapmark.maxDimension": {
          "type": "number",
          "default": 1920,
          "minimum": 0,
          "description": "Maximum pixel dimension (width or height) when copying to clipboard. Larger screenshots are downscaled proportionally to reduce LLM token cost and upload latency. Set to 0 to disable."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package -o dist/snapmark-$npm_package_version.vsix",
    "vendor:fabric": "mkdir -p media && curl -L https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.1/fabric.min.js -o media/fabric.min.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rajitha302/Snapmark.git"
  }
}
